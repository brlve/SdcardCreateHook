<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SD卡根目录创建监视 (LSPosed)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="模块状态：请在 LSPosed 中启用本模块并勾选作用域后重启"
        android:textSize="14sp"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="日志文件位置：\n/storage/emulated/0/Download/sdcard_create_hook.log"
        android:textSize="13sp"
        android:paddingBottom="12dp" />

    <Button
        android:id="@+id/btnRefresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="刷新日志" />

    <Button
        android:id="@+id/btnClear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="清空日志"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnOpenLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="用其他应用打开日志"
        android:layout_marginTop="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="#F5F5F5">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="点击「刷新日志」查看记录" />
    </ScrollView>
</LinearLayout>
